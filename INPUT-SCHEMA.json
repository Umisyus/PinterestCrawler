{
  "title": "Actor input schema",
  "description": "This is actor input schema",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "profileName": {
      "title": "Profile Name",
      "type": "string",
      "description": "Pinterest Profile Name",
      "editor": "textfield"
    },
    "limit": {
      "title": "limit",
      "type": "integer",
      "description": "Number of pins to collect before stopping crawler.",
      "default": 100,
      "editor": "number",
      "prefill": 100,
      "minimum": 10,
      "unit": "10"
    },
    "urls": {
      "title": "Pinterest User, Board, or Section URLs",
      "type": "array",
      "description": "Add the links to user profile pages, Boards, or Sections",
      "editor": "stringList",
      "uniqueItems": true
    }
  },
  "required": []
}