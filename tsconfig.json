{
  "extends": "@apify/tsconfig",
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "outDir": "dist",
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "lib": [
      "DOM",
      "es5",
      "es6",
      "dom.iterable"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "test",
    "tests",
    "examples",
    "docs",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.tsx"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
