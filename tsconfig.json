{
  "extends": "@apify/tsconfig",
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "node",
    "outDir": "dist",
    "importHelpers": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "lib": [
      "DOM",
      "es5",
      "es6",
      "dom.iterable",
      "ESNext"
    ],
    "baseUrl": "./",
    "paths": {
      "tslib": [
        "path/to/node_modules/tslib/tslib.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "test",
    "tests",
    "examples",
    "docs",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.tsx"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
